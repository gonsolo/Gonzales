        500.0, 0.191, 510.0, 0.192, 520.0, 0.192, 530.0, 0.192,
        540.0, 0.192, 550.0, 0.192, 560.0, 0.192, 570.0, 0.193,
        580.0, 0.192, 590.0, 0.192, 600.0, 0.191, 610.0, 0.189,
        620.0, 0.188, 630.0, 0.186, 640.0, 0.184, 650.0, 0.182,
        660.0, 0.181, 670.0, 0.179, 680.0, 0.178, 690.0, 0.176,
        700.0, 0.174, 710.0, 0.173, 720.0, 0.172, 730.0, 0.171,
    ]

# swatch 22: 36 (wavelength,value) pairs
def _SWATCH_22() -> List[Float64]:
    return [
        380.0, 0.068, 390.0, 0.077, 400.0, 0.084, 410.0, 0.087,
        420.0, 0.089, 430.0, 0.09, 440.0, 0.092, 450.0, 0.092,
        460.0, 0.091, 470.0, 0.09, 480.0, 0.09, 490.0, 0.09,
        500.0, 0.09, 510.0, 0.09, 520.0, 0.09, 530.0, 0.09,
        540.0, 0.09, 550.0, 0.09, 560.0, 0.09, 570.0, 0.09,
        580.0, 0.09, 590.0, 0.089, 600.0, 0.089, 610.0, 0.088,
        620.0, 0.087, 630.0, 0.086, 640.0, 0.086, 650.0, 0.085,
        660.0, 0.084, 670.0, 0.084, 680.0, 0.083, 690.0, 0.083,
        700.0, 0.082, 710.0, 0.081, 720.0, 0.081, 730.0, 0.081,
    ]

# swatch 23: 36 (wavelength,value) pairs
def _SWATCH_23() -> List[Float64]:
    return [
        380.0, 0.031, 390.0, 0.032, 400.0, 0.032, 410.0, 0.033,
        420.0, 0.033, 430.0, 0.033, 440.0, 0.033, 450.0, 0.033,
        460.0, 0.032, 470.0, 0.032, 480.0, 0.032, 490.0, 0.032,
        500.0, 0.032, 510.0, 0.032, 520.0, 0.032, 530.0, 0.032,
        540.0, 0.032, 550.0, 0.032, 560.0, 0.032, 570.0, 0.032,
        580.0, 0.032, 590.0, 0.032, 600.0, 0.032, 610.0, 0.032,
        620.0, 0.032, 630.0, 0.032, 640.0, 0.032, 650.0, 0.032,
        660.0, 0.032, 670.0, 0.032, 680.0, 0.032, 690.0, 0.032,
        700.0, 0.032, 710.0, 0.032, 720.0, 0.032, 730.0, 0.033,
    ]

# ── Piecewise-linear evaluation ──────────────────────────────────────────────
# PBRT's PiecewiseLinearSpectrum::operator(): 0 strictly OUTSIDE the table's
# native range (NOT clamped to the endpoint -- that's spd.mojo's convention
# for measured optical constants, a deliberate difference documented there).

def _pls_eval(wl_val: List[Float64], lam: Float64) -> Float64:
    var n = len(wl_val) // 2
    if n == 0:
        return Float64(0.0)
    var w_lo = wl_val[0]
    var w_hi = wl_val[(n - 1) * 2]
    if lam < w_lo or lam > w_hi:
        return Float64(0.0)
    var lo = 0
    var hi = n - 1
    while hi - lo > 1:
        var mid = (lo + hi) // 2
        if wl_val[mid * 2] <= lam:
            lo = mid
        else:
            hi = mid
    var w0 = wl_val[lo * 2]; var v0 = wl_val[lo * 2 + 1]
    var w1 = wl_val[hi * 2]; var v1 = wl_val[hi * 2 + 1]
    if w1 <= w0:
        return v0
    var t = (lam - w0) / (w1 - w0)
    return v0 + t * (v1 - v0)

def _plain_eval_zero_outside(lambdas: List[Float64], values: List[Float64], lam: Float64) -> Float64:
    var n = len(lambdas)
    if n == 0:
        return Float64(0.0)
    if lam < lambdas[0] or lam > lambdas[n - 1]:
        return Float64(0.0)
    var lo = 0
    var hi = n - 1
    while hi - lo > 1:
        var mid = (lo + hi) // 2
        if lambdas[mid] <= lam:
            lo = mid
        else:
            hi = mid
    var w0 = lambdas[lo]; var v0 = values[lo]
    var w1 = lambdas[hi]; var v1 = values[hi]
    if w1 <= w0:
        return v0
    var t = (lam - w0) / (w1 - w0)
    return v0 + t * (v1 - v0)

# ── CIE daylight illuminant series (pbrt's Spectra::D) ──────────────────────
# Used as the sensor's whitebalance illuminant during calibration. The
# absolute scale of this function's return value is IRRELEVANT to the final
# fitted matrix (every place it's used forms a ratio of two integrals both
# weighted by this same illuminant -- see ProjectReflectance's shared
# g_integral denominator), so no normalization constant is ported here,
# matching pbrt's own Spectra::D (which doesn't normalize it either).

def _raw_blackbody_at(cct: Float64, lam_nm: Float64) -> Float64:
    """Un-normalized Planck's law -- only reachable for whitebalance CCT
    below ~4000K (pbrt: 'CIE D ill-defined, use blackbody'), which no scene
    in this corpus exercises (all are >=5000K); kept for parity. Absolute
    scale is irrelevant here too, per this file's header derivation."""
    if cct <= 0.0:
        return 0.0
    var c = 299792458.0
    var h = 6.62606957e-34
    var kb = 1.3806488e-23
    var l = lam_nm * 1e-9
    var xarg = (h * c) / (l * kb * cct)
    if xarg > 700.0:
        return 0.0
    return (2.0 * h * c * c) / (l * l * l * l * l * (exp(xarg) - 1.0))

def _d_illuminant_at(temp_k: Float64, lam_nm: Float64) -> Float64:
    var cct = temp_k * 1.4388 / 1.4380
    if cct < 4000.0:
        return _raw_blackbody_at(cct, lam_nm)
    var x: Float64
    if cct <= 7000.0:
        x = -4.607e9 / (cct * cct * cct) + 2.9678e6 / (cct * cct) + 0.09911e3 / cct + 0.244063
    else:
        x = -2.0064e9 / (cct * cct * cct) + 1.9018e6 / (cct * cct) + 0.24748e3 / cct + 0.23704
    var y = -3.0 * x * x + 2.870 * x - 0.275
    var m = 0.0241 + 0.2562 * x - 0.7341 * y
    if m > -1e-12 and m < 1e-12:
        m = 1e-12
    var m1 = (-1.3515 - 1.7703 * x + 5.9114 * y) / m
    var m2 = (0.0300 - 31.4424 * x + 30.0717 * y) / m
    var lambdas = _CIE_S_LAMBDA()
    var s0v = _plain_eval_zero_outside(lambdas, _CIE_S0(), lam_nm)
    var s1v = _plain_eval_zero_outside(lambdas, _CIE_S1(), lam_nm)
    var s2v = _plain_eval_zero_outside(lambdas, _CIE_S2(), lam_nm)
    return (s0v + s1v * m1 + s2v * m2) * 0.01

# ── 24 Macbeth swatch dispatch ───────────────────────────────────────────────

def _swatch(i: Int) -> List[Float64]:
    if i == 0: return _SWATCH_0()
    elif i == 1: return _SWATCH_1()
    elif i == 2: return _SWATCH_2()
    elif i == 3: return _SWATCH_3()
    elif i == 4: return _SWATCH_4()
    elif i == 5: return _SWATCH_5()
    elif i == 6: return _SWATCH_6()
    elif i == 7: return _SWATCH_7()
    elif i == 8: return _SWATCH_8()
    elif i == 9: return _SWATCH_9()
    elif i == 10: return _SWATCH_10()
    elif i == 11: return _SWATCH_11()
    elif i == 12: return _SWATCH_12()
    elif i == 13: return _SWATCH_13()
    elif i == 14: return _SWATCH_14()
    elif i == 15: return _SWATCH_15()
    elif i == 16: return _SWATCH_16()
    elif i == 17: return _SWATCH_17()
    elif i == 18: return _SWATCH_18()
    elif i == 19: return _SWATCH_19()
    elif i == 20: return _SWATCH_20()
    elif i == 21: return _SWATCH_21()
    else: return _SWATCH_22() if i == 22 else _SWATCH_23()

comptime N_SWATCHES = 24

# ── Named sensor curve dispatch ──────────────────────────────────────────────

def named_sensor_is_supported(name: String) -> Bool:
    return name == "nikon_d850" or name == "canon_eos_100d" or name == "canon_eos_5d_mkiv"

def named_sensor_curves(name: String) -> Tuple[Bool, List[Float64], List[Float64], List[Float64]]:
    if name == "nikon_d850":
        return (True, _NIKON_D850_R(), _NIKON_D850_G(), _NIKON_D850_B())
    elif name == "canon_eos_100d":
        return (True, _CANON_EOS_100D_R(), _CANON_EOS_100D_G(), _CANON_EOS_100D_B())
    elif name == "canon_eos_5d_mkiv":
        return (True, _CANON_EOS_5D_MKIV_R(), _CANON_EOS_5D_MKIV_G(), _CANON_EOS_5D_MKIV_B())
    else:
        return (False, List[Float64](), List[Float64](), List[Float64]())

# ── ProjectReflectance (pbrt film.h's private template, both instantiations) ─
# Plain integer-nm sum over [360,830] (471 terms) -- NOT a true dlambda-scaled
# integral, matching pbrt exactly (its own loop is `for (lambda=360;
# lambda<=830;++lambda)`, no dlambda factor). Both instantiations share the
# same denominator convention: divide by the integral of the SECOND basis
# function against the illuminant, computed once per call.

def _project_reflectance_sensor(
    refl: List[Float64], wb_temp: Float64,
    r_curve: List[Float64], g_curve: List[Float64], b_curve: List[Float64],
) -> Tuple[Float64, Float64, Float64]:
    var g_integral = Float64(0.0)
    var r0 = Float64(0.0); var r1 = Float64(0.0); var r2 = Float64(0.0)
    var lam = 360.0
    while lam <= 830.0:
        var illum_v = _d_illuminant_at(wb_temp, lam)
        var refl_v = _pls_eval(refl, lam)
        var b1v = _pls_eval(r_curve, lam)
        var b2v = _pls_eval(g_curve, lam)
        var b3v = _pls_eval(b_curve, lam)
        g_integral += b2v * illum_v
        r0 += b1v * refl_v * illum_v
        r1 += b2v * refl_v * illum_v
        r2 += b3v * refl_v * illum_v
        lam += 1.0
    if g_integral > -1e-30 and g_integral < 1e-30:
        g_integral = 1e-30
    return (r0 / g_integral, r1 / g_integral, r2 / g_integral)

def _project_reflectance_xyz(refl: List[Float64]) -> Tuple[Float64, Float64, Float64]:
    """Output-side projection: always the sRGB output color space's own D65
    illuminant (gonzales's existing _cie_d65, one-time-setup convention) and
    the exact tabulated CIE X/Y/Z curves -- matches pbrt's
    `ProjectReflectance<XYZ>(s, &outputColorSpace->illuminant, &Spectra::X(),
    &Spectra::Y(), &Spectra::Z())` for the sRGB output color space."""
    var x_tbl = _CIE_X(); var y_tbl = _CIE_Y(); var z_tbl = _CIE_Z()
    var g_integral = Float64(0.0)
    var r0 = Float64(0.0); var r1 = Float64(0.0); var r2 = Float64(0.0)
    var lam = 360.0
    while lam <= 830.0:
        var illum_v = _cie_d65(lam)
        var refl_v = _pls_eval(refl, lam)
        var xv = _cie_interp(x_tbl, lam)
        var yv = _cie_interp(y_tbl, lam)
        var zv = _cie_interp(z_tbl, lam)
        g_integral += yv * illum_v
        r0 += xv * refl_v * illum_v
        r1 += yv * refl_v * illum_v
        r2 += zv * refl_v * illum_v
        lam += 1.0
    if g_integral > -1e-30 and g_integral < 1e-30:
        g_integral = 1e-30
    return (r0 / g_integral, r1 / g_integral, r2 / g_integral)

# ── 3x3 linear algebra (one-time calibration only, Float64) ─────────────────

def _mat3_inverse(m: List[Float64]) -> List[Float64]:
    """m and the result are row-major 9-element lists. Cofactor/adjugate
    method -- small, exact, no iteration; fine for a one-time 3x3 solve."""
    var a=m[0]; var b=m[1]; var c=m[2]
    var d=m[3]; var e=m[4]; var f=m[5]
    var g=m[6]; var h=m[7]; var i=m[8]
    var det = a*(e*i - f*h) - b*(d*i - f*g) + c*(d*h - e*g)
    if det > -1e-30 and det < 1e-30:
        det = 1e-30
    var inv_det = 1.0 / det
    var out = List[Float64](capacity=9)
    out.append((e*i - f*h) * inv_det); out.append((c*h - b*i) * inv_det); out.append((b*f - c*e) * inv_det)
    out.append((f*g - d*i) * inv_det); out.append((a*i - c*g) * inv_det); out.append((c*d - a*f) * inv_det)
    out.append((d*h - e*g) * inv_det); out.append((b*g - a*h) * inv_det); out.append((a*e - b*d) * inv_det)
    return out^

def _mat3_mul(a: List[Float64], b: List[Float64]) -> List[Float64]:
    var out = List[Float64](capacity=9)
    for r in range(3):
        for c in range(3):
            var acc = 0.0
            for k in range(3):
                acc += a[r * 3 + k] * b[k * 3 + c]
            out.append(acc)
    return out^

def _solve_xyz_from_sensor_rgb(rgb_camera: List[Float64], xyz_output: List[Float64]) -> List[Float64]:
    """pbrt's LinearLeastSquares(rgbCamera, xyzOutput, 24): solve for the 3x3
    X minimizing ||rgbCamera @ X - xyzOutput||^2 via normal equations
    (AtA X = AtB, X = AtA^-1 AtB), then transpose -- pbrt's LinearLeastSquares
    returns Transpose(AtAi * AtB) because its A/B rows are (r,g,b)/(x,y,z)
    triples, not column vectors; this reproduces that exactly, both matrices
    are 24x3 flattened row-major (row i = swatch i's 3 values)."""
    var ata = List[Float64](capacity=9)
    for _ in range(9): ata.append(0.0)
    var atb = List[Float64](capacity=9)
    for _ in range(9): atb.append(0.0)
    for i in range(3):
        for j in range(3):
            var s_ata = 0.0
            var s_atb = 0.0
            for r in range(N_SWATCHES):
                s_ata += rgb_camera[r * 3 + i] * rgb_camera[r * 3 + j]
                s_atb += rgb_camera[r * 3 + i] * xyz_output[r * 3 + j]
            ata[i * 3 + j] = s_ata
            atb[i * 3 + j] = s_atb
    var ata_inv = _mat3_inverse(ata)
    var m = _mat3_mul(ata_inv, atb)          # AtAi * AtB
    # Transpose
    var out = List[Float64](capacity=9)
    out.append(m[0]); out.append(m[3]); out.append(m[6])
    out.append(m[1]); out.append(m[4]); out.append(m[7])
    out.append(m[2]); out.append(m[5]); out.append(m[8])
    return out^

# ── Top-level entry point ────────────────────────────────────────────────────

def named_sensor_srgb_matrix(
    sensor_name: String, whitebalance_temp_in: Float32,
) -> Tuple[Bool, SIMD[DType.float32, 16], List[Float32], List[Float32], List[Float32]]:
    var curves = named_sensor_curves(sensor_name)
    var supported = curves[0]
    var empty_wb = SIMD[DType.float32, 16](0)
    if not supported:
        return (False, empty_wb, List[Float32](), List[Float32](), List[Float32]())

    var r_curve = curves[1].copy(); var g_curve = curves[2].copy(); var b_curve = curves[3].copy()

    # pbrt's Create(): non-cie1931 sensor defaults whitebalance to 6500K when
    # the scene leaves it at 0 (its own "unspecified" sentinel).
    var wb_temp = Float64(whitebalance_temp_in)
    if wb_temp == 0.0:
        wb_temp = 6500.0

    # Calibration: fit XYZFromSensorRGB against the 24 Macbeth swatches.
    var rgb_camera = List[Float64](capacity=N_SWATCHES * 3)
    var xyz_output = List[Float64](capacity=N_SWATCHES * 3)
    for _ in range(N_SWATCHES * 3):
        rgb_camera.append(0.0); xyz_output.append(0.0)

    # sensorWhiteY/sensorWhiteG: pbrt's InnerProduct(sensorIllum, g_bar) and
    # InnerProduct(sensorIllum, Y) -- same integer-nm sum convention, no
    # per-basis normalization (this is the RAW inner product, unlike
    # ProjectReflectance which divides by its own g_integral).
    var white_g = Float64(0.0)
    var white_y = Float64(0.0)
    var lam = 360.0
    while lam <= 830.0:
        var illum_v = _d_illuminant_at(wb_temp, lam)
        white_g += _pls_eval(g_curve, lam) * illum_v
        white_y += _cie_interp(_CIE_Y(), lam) * illum_v
        lam += 1.0
    if white_g > -1e-30 and white_g < 1e-30:
        white_g = 1e-30
    var y_over_g = white_y / white_g

    for s in range(N_SWATCHES):
        var refl = _swatch(s)
        var rgb = _project_reflectance_sensor(refl, wb_temp, r_curve, g_curve, b_curve)
        rgb_camera[s * 3 + 0] = rgb[0]; rgb_camera[s * 3 + 1] = rgb[1]; rgb_camera[s * 3 + 2] = rgb[2]
        var xyz = _project_reflectance_xyz(refl)
        xyz_output[s * 3 + 0] = xyz[0] * y_over_g
        xyz_output[s * 3 + 1] = xyz[1] * y_over_g
        xyz_output[s * 3 + 2] = xyz[2] * y_over_g

    var f_mat = _solve_xyz_from_sensor_rgb(rgb_camera, xyz_output)   # XYZFromSensorRGB, row-major 9

    # WB = S @ F @ inv(S), S = the fixed XYZ->sRGB matrix spectral_sample_to_rgb
    # already applies -- see this file's header. NO extra CIE_Y_INTEGRAL
    # factor: that normalization is gonzales's OWN per-sample convention
    # (matching pbrt's SampledSpectrum::ToXYZ, not PixelSensor::ToSensorRGB),
    # already baked into `buf`'s scale on BOTH sides of this substitution --
    # F itself is unit-preserving (both calibration sides, rgbCamera and
    # xyzOutput, are independently g_integral-normalized), so multiplying it
    # onto gonzales's already-renormalized buf directly is what reproduces
    # gonzales's own default (no-named-sensor) brightness convention when the
    # 'sensor' is a perfect CIE-matching-function stand-in (verified: that
    # config's fit gives F ~= Identity, so WB ~= Identity too, exactly
    # matching the plain cie1931 no-op path). An earlier version of this
    # multiplied by CIE_Y_INTEGRAL here, which instead gave WB ~=
    # CIE_Y_INTEGRAL*Identity for that same self-check -- a ~107x brightness
    # bug, caught by comparing gonzales's explosion.exr render (161x too
    # bright) against this self-check.
    var s_mat = List[Float64](capacity=9)
    s_mat.append(Float64(_XYZ_TO_SRGB00)); s_mat.append(Float64(_XYZ_TO_SRGB01)); s_mat.append(Float64(_XYZ_TO_SRGB02))
    s_mat.append(Float64(_XYZ_TO_SRGB10)); s_mat.append(Float64(_XYZ_TO_SRGB11)); s_mat.append(Float64(_XYZ_TO_SRGB12))
    s_mat.append(Float64(_XYZ_TO_SRGB20)); s_mat.append(Float64(_XYZ_TO_SRGB21)); s_mat.append(Float64(_XYZ_TO_SRGB22))
    var s_inv = _mat3_inverse(s_mat)
    var sf = _mat3_mul(s_mat, f_mat)
    var wb_mat = _mat3_mul(sf, s_inv)

    var wb = SIMD[DType.float32, 16](0)
    wb[0] = Float32(wb_mat[0]); wb[1] = Float32(wb_mat[1]); wb[2] = Float32(wb_mat[2])
    wb[3] = Float32(wb_mat[3]); wb[4] = Float32(wb_mat[4]); wb[5] = Float32(wb_mat[5])
    wb[6] = Float32(wb_mat[6]); wb[7] = Float32(wb_mat[7]); wb[8] = Float32(wb_mat[8])

    # Resample the sensor's own r/g/b response onto the dense CIE_LAMBDA_MIN..
    # CIE_LAMBDA_MAX/CIE_SAMPLES grid, to substitute for CieXyzTables'
    # x_tbl/y_tbl/z_tbl -- see this file's header for why that's sufficient.
    var x_tbl = List[Float32](capacity=CIE_SAMPLES)
    var y_tbl = List[Float32](capacity=CIE_SAMPLES)
    var z_tbl = List[Float32](capacity=CIE_SAMPLES)
    for i in range(CIE_SAMPLES):
        var l = CIE_LAMBDA_MIN + Float64(i) * (CIE_LAMBDA_MAX - CIE_LAMBDA_MIN) / Float64(CIE_SAMPLES - 1)
        x_tbl.append(Float32(_pls_eval(r_curve, l)))
        y_tbl.append(Float32(_pls_eval(g_curve, l)))
        z_tbl.append(Float32(_pls_eval(b_curve, l)))

    return (True, wb, x_tbl^, y_tbl^, z_tbl^)

# ── Lightweight Film-block pre-scan ──────────────────────────────────────────
# The real scene parse (pbrt_parser.mojo) only runs INSIDE parse_and_render,
# by which point the spectral context's CieXyzTables have already been built
# and handed in by __init__.mojo's main() -- see load_spectral_context's call
# site there. A named sensor needs its curves baked into those tables from
# the start (this file's header explains why), so __init__.mojo needs to know
# the sensor name BEFORE that call. Rather than restructure the
# already-delicate SpectralContext lifetime (see the "Keep the owning
# SpectralContext alive" comment in __init__.mojo), this does a cheap,
# throwaway text scan of just the main scene file for the two Film
# parameters that matter, ahead of the real parse. Not a tokenizer: it does
# not handle a sensor/whitebalance set via an Included file (no scene in this
# corpus does), and would silently fall back to cie1931 in that case, same as
# if the sensor were simply unsupported.

def scan_film_sensor_params(scene_text: String) raises -> Tuple[String, Float32]:
    var sensor_name = String("cie1931")
    var wb = Float32(0.0)
    var bytes = scene_text.as_bytes()
    var n = len(bytes)

    var sidx = scene_text.find('"string sensor"')
    if sidx >= 0:
        var i = sidx + String('"string sensor"').byte_length()
        var q1 = -1
        while i < n:
            if bytes[i] == UInt8(34):   # '"'
                q1 = i
                break
            i += 1
        if q1 >= 0:
            var q2 = -1
            var j = q1 + 1
            while j < n:
                if bytes[j] == UInt8(34):
                    q2 = j
                    break
                j += 1
            if q2 > q1:
                sensor_name = String(StringSlice(unsafe_from_utf8=bytes[q1 + 1:q2]))

    var widx = scene_text.find('"float whitebalance"')
    if widx >= 0:
        var k = widx + String('"float whitebalance"').byte_length()
        while k < n and (bytes[k] == UInt8(32) or bytes[k] == UInt8(9) or bytes[k] == UInt8(10)
                         or bytes[k] == UInt8(13) or bytes[k] == UInt8(91) or bytes[k] == UInt8(34)):
            k += 1     # skip space/tab/newline/cr/'['/'"'
        var start = k
        while k < n and not (bytes[k] == UInt8(32) or bytes[k] == UInt8(9) or bytes[k] == UInt8(10)
                             or bytes[k] == UInt8(13) or bytes[k] == UInt8(93) or bytes[k] == UInt8(34)):
            k += 1     # stop at space/tab/newline/cr/']'/'"'
        if k > start:
            var numstr = String(StringSlice(unsafe_from_utf8=bytes[start:k]))
            wb = Float32(atof(numstr))
    return (sensor_name, wb)
