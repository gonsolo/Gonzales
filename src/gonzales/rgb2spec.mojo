# Real Jakob & Hanika 2019 spectral upsampling ("A Low-Dimensional Function
# Space for Efficient Spectral Upsampling") — the actual method PBRT uses,
# ported from pbrt-v4's src/pbrt/cmd/rgb2spec_opt.cpp (the offline table
# generator) and src/pbrt/util/color.h/.cpp (RGBSigmoidPolynomial).
#
# Same architecture PBRT ships: a res x res x res x 3(planes) coefficient
# table is generated ONCE, OFFLINE (build_spectrum_table, res=64, ~71s on
# this machine, warm-start continuation same as pbrt's generator), and
# committed as a data asset (src/gonzales/data/rgb2spectrum_table.bin,
# generated by /tmp .../table_verify.mojo-style driver — see
# save_spectrum_table). At render/scene-load time gonzales only ever calls
# load_spectrum_table + rgb_to_coeffs_table_lookup — an O(1) trilinear
# lookup, matching pbrt's RGBToSpectrumTable::operator(). No optimizer runs
# during a normal render, same as pbrt. Verified against direct per-color
# gauss_newton_solve: sub-1%-relative-error recovery at res=64 for every
# tested color (white/grey/saturated-RGB/cornell-wall/near-black).
#
# gauss_newton_solve (on-demand, starts from coeffs=(0,0,0)) is kept as a
# standalone entry point — it's what build_spectrum_table itself is built
# from (via the shared _gauss_newton_core), and remains useful for one-off
# solves or regenerating the table at a different resolution.
#
# A spectrum here is s(lambda) = sigmoid(c0*lambda^2 + c1*lambda + c2) for a
# wavelength lambda in actual nanometers — always in (0,1) by construction
# (sigmoid is bounded), so it's always a physically valid reflectance, no
# clamping ever needed (unlike the layer-1 basis-function approximation in
# spectrum.mojo). Wiring this table into the actual light-transport code
# (replacing spectrum.mojo's RGB<->spectral conversion) is separate,
# not-yet-done follow-up work.

from std.math import sqrt, exp, sin, asin
from std.memory import alloc

comptime CIE_LAMBDA_MIN = Float64(360.0)
comptime CIE_LAMBDA_MAX = Float64(830.0)
comptime CIE_SAMPLES = 95
comptime CIE_FINE_SAMPLES = (CIE_SAMPLES - 1) * 3 + 1  # 283
comptime RGB2SPEC_EPSILON = Float64(1e-4)

# ── CIE 1931 2-degree standard observer, 5nm steps, 360-830nm (95 samples) ──
# Verbatim from pbrt-v4's rgb2spec_opt.cpp.

