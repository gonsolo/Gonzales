#version 460
#extension GL_EXT_ray_query : require

// Task #162 smoke test: trace ONE ray against a single-triangle TLAS and
// report whether it hit. Ray origin/direction and the triangle geometry are
// both fixed/hardcoded on the host side (vulkanrt.cpp) so this shader has no
// external inputs beyond the acceleration structure itself -- the whole
// point is proving the Mojo -> C++ bridge -> Vulkan -> RT-core round trip
// works, not exercising real scene data yet.

layout(local_size_x = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1, std430) buffer ResultBuffer {
    float hitT;
    uint hitFlag;
} result;

void main() {
    vec3 origin = vec3(0.25, 0.25, -1.0);
    vec3 direction = vec3(0.0, 0.0, 1.0);
    float tMin = 0.001;
    float tMax = 10.0;

    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF,
                           origin, tMin, direction, tMax);

    while (rayQueryProceedEXT(rq)) {
        if (rayQueryGetIntersectionTypeEXT(rq, false) ==
            gl_RayQueryCandidateIntersectionTriangleEXT) {
            rayQueryConfirmIntersectionEXT(rq);
        }
    }

    if (rayQueryGetIntersectionTypeEXT(rq, true) ==
        gl_RayQueryCommittedIntersectionTriangleEXT) {
        result.hitT = rayQueryGetIntersectionTEXT(rq, true);
        result.hitFlag = 1u;
    } else {
        result.hitT = -1.0;
        result.hitFlag = 0u;
    }
}
