# Two lights, power ratio ~100:1. A small bright lamp makes a caustic through a
# glass sphere; a large dim ceiling panel lights the room. Uniform light
# selection spends half the light paths on the dim panel.
Integrator "volpath" "integer maxdepth" [ 10 ]
Sampler "halton" "integer pixelsamples" [ 64 ]
Film "rgb" "string filename" [ "twolights.exr" ] "integer xresolution" [ 256 ] "integer yresolution" [ 192 ] "float maxcomponentvalue" 1e30
LookAt 0 2.2 3.4   0 0.4 0   0 1 0
Camera "perspective" "float fov" [ 45 ]
WorldBegin
AttributeBegin
  Material "diffuse" "rgb reflectance" [ 0.6 0.6 0.6 ]
  Shape "trianglemesh" "point3 P" [ -3 0 -3  3 0 -3  3 0 3  -3 0 3 ] "integer indices" [ 0 2 1 0 3 2 ]
  Shape "trianglemesh" "point3 P" [ -3 0 -2  3 0 -2  3 3 -2  -3 3 -2 ] "integer indices" [ 0 1 2 0 2 3 ]
AttributeEnd
AttributeBegin
  Material "dielectric" "float eta" [ 1.5 ]
  Translate 0 0.5 0
  Shape "sphere" "float radius" [ 0.5 ]
AttributeEnd
# bright lamp: 0.2 x 0.2 m facing down, power = 1000 * 0.04 * pi = 126
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 1000 1000 1000 ]
  Shape "trianglemesh" "point3 P" [ -0.1 2.5 -0.1  0.1 2.5 -0.1  0.1 2.5 0.1  -0.1 2.5 0.1 ] "integer indices" [ 0 1 2 0 2 3 ]
AttributeEnd
# dim panel: 2 x 2 m facing down, off to the side, power = 0.1 * 4 * pi = 1.26
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 0.1 0.1 0.1 ]
  Shape "trianglemesh" "point3 P" [ 1 3 -1.5  3 3 -1.5  3 3 0.5  1 3 0.5 ] "integer indices" [ 0 1 2 0 2 3 ]
AttributeEnd
