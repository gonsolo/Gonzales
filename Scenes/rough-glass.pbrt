# A frosted (rough dielectric, roughness 0.1) glass sphere on a floor, lit by a
# small area light and a dim environment. Rough glass used to render as smooth
# glass in all three integrators; this pins pbrt's DielectricBxDF over a
# Trowbridge-Reitz microsurface (layered.mojo's diel_*): PT through its own
# NEE + MIS, VCM and SPPM through the shared lobe interface
# (LobeKind.rough_dielectric), and MNEE/SMS must leave it alone.
Integrator "volpath" "integer maxdepth" [ 12 ]
Sampler "halton" "integer pixelsamples" [ 64 ]
Film "rgb" "string filename" [ "rough-glass.exr" ] "integer xresolution" [ 256 ] "integer yresolution" [ 192 ]
LookAt 0 1.4 3.2   0 0.5 0   0 1 0
Camera "perspective" "float fov" [ 40 ]
WorldBegin
LightSource "infinite" "rgb L" [ 0.2 0.22 0.25 ]
AttributeBegin
  Material "diffuse" "rgb reflectance" [ 0.6 0.6 0.6 ]
  Shape "trianglemesh" "point3 P" [ -4 0 -4  4 0 -4  4 0 4  -4 0 4 ] "integer indices" [ 0 2 1 0 3 2 ]
AttributeEnd
AttributeBegin
  Material "diffuse" "rgb reflectance" [ 0.7 0.3 0.2 ]
  Shape "trianglemesh" "point3 P" [ -4 0 -1.5  4 0 -1.5  4 3 -1.5  -4 3 -1.5 ] "integer indices" [ 0 1 2 0 2 3 ]
AttributeEnd
AttributeBegin
  Material "dielectric" "float eta" [ 1.5 ] "float roughness" [ 0.1 ]
  Translate 0 0.5 0
  Shape "sphere" "float radius" [ 0.5 ]
AttributeEnd
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 20 20 20 ]
  Shape "trianglemesh" "point3 P" [ -1.2 2.5 -0.3  -0.6 2.5 -0.3  -0.6 2.5 0.3  -1.2 2.5 0.3 ] "integer indices" [ 0 1 2 0 2 3 ]
AttributeEnd
