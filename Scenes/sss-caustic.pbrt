# A caustic on skin: a small light focused through a glass sphere onto a thick subsurface slab.
LookAt 0 7 7  0 0 0  0 1 0
Camera "perspective" "float fov" [ 40 ]
Sampler "independent" "integer pixelsamples" [ 64 ]
Integrator "volpath" "integer maxdepth" [ 16 ]
Film "rgb" "string filename" [ "sss-caustic.exr" ] "integer xresolution" [ 256 ] "integer yresolution" [ 256 ]
WorldBegin
LightSource "infinite" "rgb L" [ 0.03 0.03 0.03 ]
AttributeBegin
  Material "subsurface" "float eta" [ 1.33 ] "rgb sigma_a" [ 0.2 0.8 1.6 ] "rgb sigma_s" [ 40 40 40 ] "float g" [ 0 ] "float scale" [ 1 ]
  Shape "trianglemesh" "point3 P" [ -6 -2 -6  6 -2 -6  6 0 -6  -6 0 -6  -6 -2 6  6 -2 6  6 0 6  -6 0 6 ]
    "integer indices" [ 0 2 1 0 3 2  4 5 6 4 6 7  0 1 5 0 5 4  3 7 6 3 6 2  0 4 7 0 7 3  1 2 6 1 6 5 ]
AttributeEnd
AttributeBegin
  Material "dielectric" "float eta" [ 1.5 ]
  Translate 0 2.2 0
  Shape "sphere" "float radius" [ 1 ]
AttributeEnd
AttributeBegin
  AreaLightSource "diffuse" "rgb L" [ 8000 8000 8000 ] "bool twosided" [ true ]
  Shape "trianglemesh" "point3 P" [ -0.06 9 -0.06  0.06 9 -0.06  0.06 9 0.06  -0.06 9 0.06 ] "integer indices" [ 0 1 2 0 2 3 ]
AttributeEnd
