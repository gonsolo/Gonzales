Integrator "path" "integer maxdepth" [ 1 ]
Sampler "halton" "integer pixelsamples" [ 16 ]
Film "rgb"
    "integer xresolution" [ 256 ]
    "integer yresolution" [ 256 ]
    "string filename" [ "manylights.exr" ]
LookAt 0 3 34   0 0 -8   0 1 0
Camera "perspective" "float fov" [ 60 ]

WorldBegin

# ── Floor: pure diffuse, so every visible pixel is in ReSTIR's scope ──
AttributeBegin
    Material "diffuse" "rgb reflectance" [ 0.6 0.6 0.6 ]
    Shape "trianglemesh"
        "point3 P" [ -60.00000 0.00000 -60.00000 60.00000 0.00000 -60.00000 60.00000 0.00000 60.00000 -60.00000 0.00000 60.00000 ]
        "integer indices" [ 0 1 2 0 2 3 ]
AttributeEnd

# ── 256 equal-power area lights spread over a wide area ──
