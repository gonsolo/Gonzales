    AreaLightSource "diffuse" "rgb L" [ 60.0000 60.0000 60.0000 ]
    Material "diffuse" "rgb reflectance" [ 0 0 0 ]
    Shape "trianglemesh"
        "point3 P" [ -37.85000 12.00000 -37.85000 -37.15000 12.00000 -37.85000 -37.15000 12.00000 -37.15000 -37.85000 12.00000 -37.15000 ]
        "integer indices" [ 0 1 2 0 2 3 ]
AttributeEnd
